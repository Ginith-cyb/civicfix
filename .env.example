# Copy to .env and edit. Never commit .env.
PORT=3000
HOST=127.0.0.1
# One-time key used to create the first Super Admin. Optional locally: if empty, a key is
# generated on first start and printed in the terminal. Set your own for production.
SETUP_KEY=change-me-to-a-long-random-string
# Set both to 1 in production (behind HTTPS / a reverse proxy)
COOKIE_SECURE=0
TRUST_PROXY=0
# Where the database and uploaded photos live (back this folder up)
DATA_DIR=./data
